# lab1.qsf -- настройки проекта ЛР №1 (вариант 15), плата DE1
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY lab1
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Неиспользуемые выводы ПЛИС -- входы с третьим состоянием.
# По умолчанию Quartus выводит на них "землю", а на плате DE1 к ним подключены
# другие кнопки, переключатели и микросхемы -- так их выходы замыкались бы на землю.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# Файлы проекта
set_global_assignment -name BDF_FILE lab1.bdf
set_global_assignment -name VERILOG_FILE schetchik.v
set_global_assignment -name VERILOG_FILE rspsignals.v
set_global_assignment -name SDC_FILE lab1.sdc
set_global_assignment -name VECTOR_WAVEFORM_FILE lab1.vwf

# Моделирование (ModelSim-Altera, University Program VWF)
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation

# Привязка пинов (вариант 15): C -> KEY[1], Y[3..0] -> LEDG[7..4]
set_location_assignment PIN_R21 -to C
set_location_assignment PIN_W22 -to Y[0]
set_location_assignment PIN_W21 -to Y[1]
set_location_assignment PIN_Y22 -to Y[2]
set_location_assignment PIN_Y21 -to Y[3]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
