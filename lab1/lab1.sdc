# lab1.sdc -- временные ограничения ЛР №1 (вариант 15)
# Синхросигнал C подаётся с кнопки KEY[1]. Для анализа задаём
# ограничение 50 МГц (период 20 нс) -- с большим запасом для счётчика.
create_clock -name C -period 20.000 [get_ports {C}]

# Учёт неопределённости тактового сигнала (джиттер и т.п.)
derive_clock_uncertainty

# Выходы на светодиоды LEDG -- асинхронные для внешнего мира,
# задаём ограничение на задержку от регистра до выходного пина.
set_output_delay -clock C 0.000 [get_ports {Y[*]}]
